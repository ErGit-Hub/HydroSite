# SPA-фолбэк для Apache/Plesk: без него прямой заход на /news/3 или /contacts
# вернёт 404 от сервера — на диске таких файлов нет, маршруты живут в браузере.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # существующий файл или каталог отдаём как есть
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # пропавший ассет или чанк — честный 404, а не index.html со статусом 200:
  # иначе браузер получит HTML вместо скрипта и навигация молча сломается
  RewriteRule \.(js|mjs|css|map|json|png|jpe?g|gif|svg|ico|webp|avif|woff2?|ttf|eot|pdf)$ - [L,R=404]

  # всё остальное — приложению
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # имена чанков и стилей содержат хэш содержимого: меняется файл — меняется имя
  <FilesMatch "^(main|polyfills|styles|chunk)-[A-Z0-9]+\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # оболочка и переводы меняются без смены имени — кэшировать нельзя
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.json$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
